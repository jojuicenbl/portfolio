---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const email = "contact@jorisneblai.xyz";
---
<BaseLayout title="Contact — Joris Neblai" description="Get in touch with Joris Neblai">
  <Header />

  <div class="max-w-2xl mx-auto">
    <!-- Header Section -->
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-indigo-400 to-purple-500 bg-clip-text text-transparent">
        Let's talk
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400">
        Have questions or a project in mind? Send a message through the form. I respond as soon as possible.
      </p>
    </div>

    <!-- Contact Form -->
    <div
      x-data="{
        submitted: false,
        name: '',
        email: '',
        message: '',
        async submitForm(e) {
          e.preventDefault();

          // Show success message
          this.submitted = true;

          // Try to open mailto
          const subject = encodeURIComponent(`Portfolio Contact from ${this.name}`);
          const body = encodeURIComponent(`Name: ${this.name}\nEmail: ${this.email}\n\nMessage:\n${this.message}`);

          // Use setTimeout to ensure the success message shows first
          setTimeout(() => {
            window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
          }, 1000);

          // Reset form after 3 seconds
          setTimeout(() => {
            this.name = '';
            this.email = '';
            this.message = '';
            this.submitted = false;
          }, 3000);
        }
      }"
      class="relative"
    >
      <!-- Success Message -->
      <div
        x-show="submitted"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 scale-90"
        x-transition:enter-end="opacity-100 scale-100"
        class="absolute inset-0 z-10 flex items-center justify-center bg-white/95 dark:bg-[#121212]/95 backdrop-blur-sm rounded-2xl"
      >
        <div class="text-center p-8">
          <div class="mb-4 inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-r from-indigo-500 to-purple-600">
            <svg class="w-8 h-8 text-white animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2 text-neutral-900 dark:text-neutral-100">Message sent!</h3>
          <p class="text-neutral-600 dark:text-neutral-400">Thank you for reaching out. I'll get back to you soon.</p>
        </div>
      </div>

      <!-- Form -->
      <form @submit="submitForm" class="space-y-6 bg-neutral-50 dark:bg-neutral-900/50 p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800">
        <div>
          <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300" for="name">
            Name
          </label>
          <input
            id="name"
            x-model="name"
            type="text"
            required
            class="w-full bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 rounded-lg px-4 py-3 text-neutral-900 dark:text-neutral-100 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all"
            placeholder="Your name"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300" for="email">
            Email
          </label>
          <input
            id="email"
            x-model="email"
            type="email"
            required
            class="w-full bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 rounded-lg px-4 py-3 text-neutral-900 dark:text-neutral-100 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all"
            placeholder="your@email.com"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-2 text-neutral-700 dark:text-neutral-300" for="message">
            Message
          </label>
          <textarea
            id="message"
            x-model="message"
            rows="6"
            required
            class="w-full bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-800 rounded-lg px-4 py-3 text-neutral-900 dark:text-neutral-100 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all resize-none"
            placeholder="Your message..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-medium px-6 py-4 hover:from-indigo-600 hover:to-purple-700 transition-all shadow-lg shadow-indigo-500/20 hover:shadow-indigo-500/40"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
          Send Message
        </button>
      </form>

      <!-- Alternative Contact Methods -->
      <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-800">
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4 text-center">Or connect with me on</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:border-indigo-500 transition-all text-sm"
            href="https://linkedin.com/in/joris-neblai"
            target="_blank"
            rel="noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn
          </a>
          <a
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:border-indigo-500 transition-all text-sm"
            href="https://github.com/jojuicenbl"
            target="_blank"
            rel="noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:border-indigo-500 transition-all text-sm"
            href={`mailto:${email}`}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {email}
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>
