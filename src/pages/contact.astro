---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const email = "contact@jorisneblai.xyz";
---
<BaseLayout title="Contact — Joris Neblai" description="Get in touch with Joris Neblai">
  <Header />

  <div class="max-w-3xl mx-auto">
    <!-- Header Section -->
    <div class="mb-12 md:mb-16 opacity-0 animate-fade-in-up delay-200">
      <div class="relative">
        <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-tight mb-6">
          <span class="block">Let's</span>
          <span class="block text-[var(--color-accent)]">talk</span>
        </h1>
        <div class="absolute -top-2 -left-2 w-6 h-6 rounded border-2 border-[var(--color-accent)] hidden md:block"></div>
      </div>
      <p class="font-mono text-sm md:text-base text-[var(--color-text-secondary)] max-w-2xl mt-6">
        <span class="text-[var(--color-accent)]">&gt;</span> Have questions or a project in mind? Send a message through the form. I respond as soon as possible.
      </p>
    </div>

    <!-- Contact Form -->
    <div id="contact-form-container" class="relative">
      <!-- Success Message -->
      <div
        id="success-message"
        class="hidden absolute inset-0 z-10 flex items-center justify-center bg-[var(--color-bg)]/98 backdrop-blur-sm rounded-xl border-2 border-[var(--color-accent)] animate-fadeIn"
      >
        <div class="text-center p-8">
          <div class="mb-6 inline-flex items-center justify-center w-16 h-16 rounded-lg border-2 border-[var(--color-accent)] bg-[var(--color-accent)]">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-display text-2xl md:text-3xl font-bold mb-3">Message sent!</h3>
          <p class="font-mono text-sm text-[var(--color-text-secondary)]">Thank you for reaching out. I'll get back to you soon.</p>
        </div>
      </div>

      <!-- Error Message -->
      <div
        id="error-message"
        class="hidden mb-6 p-4 rounded-lg bg-red-500/10 border-2 border-red-500 font-mono text-sm text-red-500"
      >
        <p id="error-text"></p>
      </div>

      <!-- Form -->
      <form id="contact-form" class="space-y-5 md:space-y-6 bg-[var(--color-bg-secondary)] p-6 md:p-8 rounded-xl border-2 border-[var(--color-border-light)] relative opacity-0 animate-fade-in-up delay-400">
        <div class="absolute top-0 left-0 w-20 h-1 bg-[var(--color-accent)] rounded-tl-xl"></div>
        <div>
          <label class="block text-xs font-mono font-semibold mb-3 text-[var(--color-text)] uppercase tracking-wider" for="name">
            <span class="text-[var(--color-accent)]">&gt;</span> NAME
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            minlength="2"
            maxlength="100"
            class="w-full bg-[var(--color-bg)] border-[2px] border-[var(--color-border-light)] px-4 py-3 font-mono text-sm focus:border-[var(--color-accent)] focus:outline-none transition-all"
            placeholder="Your name"
          />
        </div>

        <div>
          <label class="block text-xs font-mono font-semibold mb-3 text-[var(--color-text)] uppercase tracking-wider" for="email">
            <span class="text-[var(--color-accent)]">&gt;</span> EMAIL
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full bg-[var(--color-bg)] border-[2px] border-[var(--color-border-light)] px-4 py-3 font-mono text-sm focus:border-[var(--color-accent)] focus:outline-none transition-all"
            placeholder="your@email.com"
          />
        </div>

        <div>
          <label class="block text-xs font-mono font-semibold mb-3 text-[var(--color-text)] uppercase tracking-wider" for="message">
            <span class="text-[var(--color-accent)]">&gt;</span> MESSAGE
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            minlength="10"
            maxlength="5000"
            class="w-full bg-[var(--color-bg)] border-[2px] border-[var(--color-border-light)] px-4 py-3 font-mono text-sm focus:border-[var(--color-accent)] focus:outline-none transition-all resize-none"
            placeholder="Your message..."
          ></textarea>
        </div>

        <button
          type="submit"
          id="submit-button"
          class="w-full inline-flex items-center justify-center gap-2 bg-[var(--color-accent)] text-white rounded-lg font-mono font-bold capitalize px-6 py-3 md:py-4 border-2 border-[var(--color-accent)] hover:bg-[var(--color-accent-dark)] hover:border-[var(--color-accent-dark)] transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" id="send-icon" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
          </svg>
          <svg class="hidden animate-spin h-5 w-5" id="loading-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span id="button-text">Send message</span>
        </button>
      </form>

      <!-- Alternative Contact Methods -->
      <div class="mt-10 md:mt-12 pt-6 md:pt-8 border-t-2 border-[var(--color-border-light)]">
        <p class="font-mono text-xs text-[var(--color-text-secondary)] mb-5 md:mb-6 text-center">
          <span class="text-[var(--color-accent)]">&gt;</span> Or connect with me on
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            class="inline-flex items-center gap-2 px-4 md:px-5 py-2.5 md:py-3 bg-[var(--color-bg)] rounded-lg border-2 border-[var(--color-border-light)] hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-secondary)] transition-all text-sm font-mono font-semibold"
            href="https://linkedin.com/in/joris-neblai"
            target="_blank"
            rel="noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn
          </a>
          <a
            class="inline-flex items-center gap-2 px-4 md:px-5 py-2.5 md:py-3 bg-[var(--color-bg)] rounded-lg border-2 border-[var(--color-border-light)] hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-secondary)] transition-all text-sm font-mono font-semibold"
            href="https://github.com/jojuicenbl"
            target="_blank"
            rel="noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a
            class="inline-flex items-center gap-2 px-4 md:px-5 py-2.5 md:py-3 bg-[var(--color-bg)] rounded-lg border-2 border-[var(--color-border-light)] hover:border-[var(--color-accent)] hover:bg-[var(--color-bg-secondary)] transition-all text-sm font-mono font-semibold"
            href={`mailto:${email}`}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {email}
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const buttonText = document.getElementById('button-text') as HTMLSpanElement;
  const sendIcon = document.getElementById('send-icon') as HTMLElement;
  const loadingIcon = document.getElementById('loading-icon') as HTMLElement;
  const successMessage = document.getElementById('success-message') as HTMLDivElement;
  const errorMessage = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Hide previous messages
    successMessage.classList.add('hidden');
    errorMessage.classList.add('hidden');

    // Get form data
    const formData = new FormData(form);
    const data = {
      name: formData.get('name') as string,
      email: formData.get('email') as string,
      message: formData.get('message') as string,
    };

    // Update button state
    submitButton.disabled = true;
    buttonText.textContent = 'Sending...';
    sendIcon.classList.add('hidden');
    loadingIcon.classList.remove('hidden');

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        // Show success message
        successMessage.classList.remove('hidden');

        // Reset form
        form.reset();

        // Hide success message after 5 seconds
        setTimeout(() => {
          successMessage.classList.add('hidden');
        }, 5000);
      } else {
        // Show error message
        errorText.textContent = result.error || 'Failed to send message. Please try again.';
        errorMessage.classList.remove('hidden');

        // Auto-hide error after 5 seconds
        setTimeout(() => {
          errorMessage.classList.add('hidden');
        }, 5000);
      }
    } catch (error) {
      console.error('Error sending message:', error);
      errorText.textContent = 'Network error. Please check your connection and try again.';
      errorMessage.classList.remove('hidden');

      setTimeout(() => {
        errorMessage.classList.add('hidden');
      }, 5000);
    } finally {
      // Reset button state
      submitButton.disabled = false;
      buttonText.textContent = 'Send Message';
      sendIcon.classList.remove('hidden');
      loadingIcon.classList.add('hidden');
    }
  });
</script>
