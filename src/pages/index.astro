---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";

const email = import.meta.env.PUBLIC_EMAIL;
---
<BaseLayout>
  <Header />

  <Section id="about" title="About me">
    <div class="space-y-4 text-neutral-300 leading-relaxed">
      <p class="text-lg">
        Full-Stack Web Developer specializing in React, Next.js, and NestJS. I build robust front-end interfaces and scalable back-end APIs, with a strong focus on performance, testing, and developer experience.
      </p>
      <p class="text-lg">
        I operate with an AI-driven development workflow: daily use of agent automation, RAG pipelines, and tool-assisted coding to accelerate delivery while preserving quality.
      </p>
      <div class="mt-6 p-4 rounded-lg bg-neutral-900/50 border border-neutral-800">
        <p class="text-sm text-neutral-400">
          <span class="font-semibold text-indigo-400">Core stack:</span> TypeScript, React/React Native, Next.js, NestJS, PostgreSQL, Redis, AWS, TailwindCSS, Jest, Playwright.
        </p>
      </div>
    </div>
  </Section>

  <Section id="experiences" title="Experiences">
    <ul class="space-y-6">
      <li class="border-l-2 border-indigo-500 pl-4 py-2">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
          <strong class="text-lg text-neutral-100">Full-Stack Web Developer — HARVY</strong>
          <span class="text-sm text-neutral-500">Sept 2023 – Feb 2025</span>
        </div>
        <ul class="list-disc ml-5 space-y-2 text-neutral-300 marker:text-indigo-500">
          <li>Developed and optimized NestJS REST APIs for performance and scalability.</li>
          <li>Built a PDF generation service (Puppeteer, pdf-lib, Handlebars) processing 1,000+ documents per month.</li>
          <li>Jest unit and Playwright end-to-end tests reaching ~90% coverage; improved CI quality gates.</li>
          <li>Implemented Datadog for error tracking, reducing average resolution time.</li>
          <li>Contributed to product decisions in close collaboration with founders.</li>
        </ul>
      </li>

      <li class="border-l-2 border-purple-500 pl-4 py-2">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
          <strong class="text-lg text-neutral-100">Front-End Developer — PUBLIDATA</strong>
          <span class="text-sm text-neutral-500">Jan 2023 – Jul 2023</span>
        </div>
        <ul class="list-disc ml-5 space-y-2 text-neutral-300 marker:text-purple-500">
          <li>Shipped new React features and reusable components; authored custom hooks to improve maintainability.</li>
          <li>Enhanced UI with TailwindCSS; improved mobile experience and reduced bundle size via lazy loading/code-splitting.</li>
          <li>Set up Storybook documentation to streamline onboarding; active in code reviews and pair programming.</li>
          <li>Contributed to a React Native app used by 500+ B2B customers.</li>
        </ul>
      </li>

      <li class="border-l-2 border-neutral-600 pl-4 py-2">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
          <strong class="text-lg text-neutral-100">Technical Specialist — APPLE</strong>
          <span class="text-sm text-neutral-500">Jun 2016 – Dec 2019</span>
        </div>
        <ul class="list-disc ml-5 space-y-2 text-neutral-300 marker:text-neutral-600">
          <li>Diagnosed and repaired complex hardware/software issues at scale; trained new technicians.</li>
          <li>Delivered 500+ advanced diagnostics and repairs per year; maintained high service quality.</li>
        </ul>
      </li>

      <li class="border-l-2 border-neutral-600 pl-4 py-2">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
          <strong class="text-lg text-neutral-100">Web & Mobile Web Developer Training (JS/React) — O'Clock</strong>
          <span class="text-sm text-neutral-500">May 2022 – Oct 2022</span>
        </div>
        <ul class="list-disc ml-5 space-y-2 text-neutral-300 marker:text-neutral-600">
          <li>700+ hours bootcamp covering HTML, CSS, JS, React, accessibility, SEO, Agile, TDD, and documentation.</li>
          <li>Built a full-stack final project from design to deployment.</li>
        </ul>
      </li>
    </ul>
  </Section>

  <Section id="contact" title="Contact">
    <form id="contact-form" class="space-y-4 max-w-xl">
      <div>
        <label class="block text-sm mb-2 text-neutral-300" for="name">Name</label>
        <input
          id="name"
          name="name"
          required
          class="w-full bg-neutral-900 border border-neutral-800 rounded-lg px-4 py-3 text-neutral-100 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all"
          placeholder="Your name"
        />
      </div>
      <div>
        <label class="block text-sm mb-2 text-neutral-300" for="email">Email</label>
        <input
          id="email"
          type="email"
          name="email"
          required
          class="w-full bg-neutral-900 border border-neutral-800 rounded-lg px-4 py-3 text-neutral-100 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all"
          placeholder="your@email.com"
        />
      </div>
      <div>
        <label class="block text-sm mb-2 text-neutral-300" for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full bg-neutral-900 border border-neutral-800 rounded-lg px-4 py-3 text-neutral-100 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all resize-none"
          placeholder="Your message..."
        ></textarea>
      </div>
      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-medium px-6 py-3 hover:from-indigo-600 hover:to-purple-700 transition-all shadow-lg shadow-indigo-500/20"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        Send Message
      </button>
    </form>

    <div class="mt-8 pt-8 border-t border-neutral-800">
      <p class="text-sm text-neutral-400 mb-4">Connect with me</p>
      <div class="flex flex-wrap gap-3">
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-indigo-500 transition-all text-sm"
          href="https://linkedin.com/in/joris-neblai"
          target="_blank"
          rel="noreferrer"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-indigo-500 transition-all text-sm"
          href="https://github.com/jojuicenbl"
          target="_blank"
          rel="noreferrer"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <a
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neutral-900 border border-neutral-800 hover:border-indigo-500 transition-all text-sm"
          href={`mailto:${email}`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {email}
        </a>
      </div>
    </div>
  </Section>

  <script>
    document.getElementById('contact-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const name = (form.elements.namedItem('name') as HTMLInputElement).value;
      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value;

      const subject = encodeURIComponent(`Portfolio Contact from ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`);

      window.location.href = `mailto:contact@jorisneblai.xyz?subject=${subject}&body=${body}`;
    });
  </script>

  <Footer />
</BaseLayout>
