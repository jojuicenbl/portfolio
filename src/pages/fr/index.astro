---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../data/projects";

const locale = "fr";

// Featured projects (first 3)
const featuredProjects = projects.slice(0, 3);
---
<BaseLayout locale={locale}>
  <Header locale={locale} />

  <!-- Hero Section -->
  <section class="section-spacing opacity-0 animate-fade-in-up delay-200">
    <div class="content-width">
      <div class="max-w-4xl relative">
        <!-- Decorative blob -->
        <div class="blob-bg top-0 -left-20 w-96 h-96 bg-accent opacity-10 -z-10"></div>

        <p class="text-overline mb-6">Développeur Full-Stack Freelance & Ingénieur IA</p>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-semibold mb-8 leading-tight">
          Créer des Expériences
          <span class="block text-accent italic">Numériques Intelligentes</span>
        </h1>
        <p class="text-lg text-secondary max-w-2xl mb-12 leading-relaxed">
          J'aide les entreprises à développer des produits IA, des APIs scalables et des applications web de haute qualité — du prototype rapide aux solutions prêtes pour la production.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#work" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Voir mes projets
          </a>
          <a href="/fr/contact" class="btn-secondary">
            Me contacter
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section id="work" class="section-spacing bg-surface/30 opacity-0 animate-fade-in-up delay-400">
    <div class="content-width">
      <div class="mb-12">
        <h2 class="font-display text-3xl md:text-4xl font-semibold mb-4">
          Projets <span class="text-accent italic">Sélectionnés</span>
        </h2>
        <p class="text-secondary max-w-2xl">
          Une sélection de projets récents mettant en avant des intégrations IA, du développement full-stack et des solutions scalables.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 mb-12">
        {featuredProjects.map(project => (
          <ProjectCard {...project} />
        ))}
      </div>

      <div class="text-center">
        <a href="/fr/projects" class="btn-ghost inline-flex items-center gap-2">
          Voir tous les projets
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="section-spacing opacity-0 animate-fade-in-up delay-500">
    <div class="content-width">
      <div class="mb-12">
        <h2 class="font-display text-3xl md:text-4xl font-semibold mb-4">
          Ce que je <span class="text-accent italic">Fais</span>
        </h2>
        <p class="text-secondary max-w-2xl">
          Services de développement complets axés sur les technologies modernes et les solutions pilotées par l'IA.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-12">
        <!-- AI Development -->
        <article class="card-hover">
          <div class="w-12 h-12 text-accent mb-6">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
            </svg>
          </div>
          <h3 class="font-display text-xl md:text-2xl font-semibold mb-4">Développement IA</h3>
          <p class="text-sm text-secondary leading-relaxed">
            Création d'agents intelligents, pipelines RAG et intégrations LLM avec OpenAI, Anthropic, LangChain et bases de données vectorielles pour des applications IA prêtes pour la production.
          </p>
        </article>

        <!-- Full-Stack Development -->
        <article class="card-hover">
          <div class="w-12 h-12 text-accent mb-6">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
            </svg>
          </div>
          <h3 class="font-display text-xl md:text-2xl font-semibold mb-4">Développement Full-Stack</h3>
          <p class="text-sm text-secondary leading-relaxed">
            Applications web complètes avec React, Next.js, Node.js, TypeScript et frameworks modernes. Architectures scalables, code propre et tests robustes.
          </p>
        </article>

        <!-- API & Backend -->
        <article class="card-hover">
          <div class="w-12 h-12 text-accent mb-6">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
            </svg>
          </div>
          <h3 class="font-display text-xl md:text-2xl font-semibold mb-4">API & Backend</h3>
          <p class="text-sm text-secondary leading-relaxed">
            APIs RESTful et GraphQL avec NestJS, FastAPI, Express. Conception de bases de données, optimisation, architecture microservices et déploiement cloud (AWS, Hostinger, Netlify).
          </p>
        </article>
      </div>

      <!-- Tech Stack -->
      <div class="card grain-texture">
        <p class="text-overline mb-4">Stack Principal</p>
        <div class="flex flex-wrap gap-2">
          {['TypeScript', 'Python', 'React', 'Next.js', 'Vue.js', 'Node.js', 'NestJS', 'Express', 'FastAPI', 'LangChain', 'OpenAI', 'PostgreSQL', 'Docker', 'AWS'].map(tech => (
            <span class="text-xs font-mono px-3 py-1.5 bg-accent-light text-accent rounded-sm">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- About Section (Compact Mobile) -->
  <section id="about" class="section-spacing bg-surface/30 opacity-0 animate-fade-in-up delay-600">
    <div class="content-width">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-col md:flex-row gap-8 items-start mb-8">
          <img
            src="/self-pic-grad.png"
            alt="Joris Neblai"
            class="w-24 h-24 md:w-32 md:h-32 rounded-2xl object-cover border-2 border-accent-light shadow-lg"
          />
          <div class="flex-1">
            <h2 class="font-display text-3xl md:text-4xl font-semibold mb-6">
              À <span class="text-accent italic">Propos</span>
            </h2>
            <div class="space-y-4 text-secondary leading-relaxed">
              <p class="about-preview">
                Je suis <strong class="text-primary">Développeur Full-Stack Freelance & Ingénieur IA</strong>, aidant les entreprises à créer des produits numériques rapides, fiables et intelligents. Je me spécialise dans la transformation d'idées en solutions prêtes pour la production avec <strong class="text-primary">JavaScript/TypeScript</strong>, <strong class="text-primary">Python</strong> et des workflows de <strong class="text-primary">développement assisté par IA</strong> modernes.
              </p>

              <div class="about-expanded" id="about-expanded">
                <p class="mb-4">
                  Mon travail couvre les <strong class="text-primary">agents IA</strong>, les <strong class="text-primary">pipelines RAG</strong>, les <strong class="text-primary">workflows automatisés</strong> et les <strong class="text-primary">applications web full-stack</strong>. J'intègre des outils comme OpenAI, Anthropic, LangChain, Ollama, bases de données vectorielles et déploiements cloud modernes pour accélérer le développement sans compromettre la qualité.
                </p>

                <p class="mb-4">
                  Je construis également des sites web performants et des expériences e-commerce avec <strong class="text-primary">WordPress</strong> (thèmes et plugins personnalisés) et <strong class="text-primary">Shopify</strong> avec personnalisation avancée Liquid.
                </p>

                <p>
                  En dehors du développement, je suis passionné de musique et de collection de vinyles, toujours à la recherche de nouveaux sons. Je reste actif grâce à la course à pied et la musculation, et j'expérimente constamment avec les technologies IA émergentes.
                </p>
              </div>

              <button
                id="read-more-btn"
                class="md:hidden flex items-center gap-2 text-accent font-mono text-sm mt-4 hover:underline"
                aria-expanded="false"
                aria-controls="about-expanded"
              >
                <span id="read-more-text">Lire plus</span>
                <svg id="chevron-icon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Section (Accordions) -->
  <section id="experiences" class="section-spacing opacity-0 animate-fade-in-up delay-700">
    <div class="content-width">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display text-3xl md:text-4xl font-semibold mb-10">
          Expérience <span class="text-accent italic">Professionnelle</span>
        </h2>

        <div class="space-y-4">
          <!-- Experience 1 -->
          <div class="accordion-item">
            <button class="accordion-header" data-accordion="exp-1">
              <div class="flex-1 text-left">
                <h3 class="font-display text-xl md:text-2xl font-semibold mb-1">
                  Développeur Web Full-Stack <span class="text-accent block md:inline">@ HARVY</span>
                </h3>
                <p class="text-xs font-mono text-tertiary uppercase">Sept 2023 – Fév 2025</p>
              </div>
              <svg class="chevron w-6 h-6 text-tertiary transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="accordion-content" id="exp-1">
              <div>
                <ul class="space-y-3 text-sm text-secondary p-6">
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Développement et optimisation d'APIs REST NestJS pour la performance et la scalabilité.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Création d'un service de génération de PDF (Puppeteer, pdf-lib, Handlebars) traitant plus de 1 000 documents par mois.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Tests unitaires Jest et end-to-end Playwright atteignant ~90% de couverture ; amélioration des contrôles qualité CI.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Mise en place de Datadog pour le suivi des erreurs, réduisant le temps de résolution moyen.</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Experience 2 -->
          <div class="accordion-item">
            <button class="accordion-header" data-accordion="exp-2">
              <div class="flex-1 text-left">
                <h3 class="font-display text-xl md:text-2xl font-semibold mb-1">
                  Développeur Front-End <span class="text-accent block md:inline">@ PUBLIDATA</span>
                </h3>
                <p class="text-xs font-mono text-tertiary uppercase">Jan 2023 – Juil 2023</p>
              </div>
              <svg class="chevron w-6 h-6 text-tertiary transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="accordion-content" id="exp-2">
              <div>
                <ul class="space-y-3 text-sm text-secondary p-6">
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Développement de nouvelles fonctionnalités React et composants réutilisables ; création de hooks personnalisés pour améliorer la maintenabilité.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Amélioration de l'UI avec TailwindCSS ; optimisation de l'expérience mobile et réduction de la taille du bundle via lazy loading.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Mise en place de la documentation Storybook pour faciliter l'onboarding ; participation active aux revues de code.</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Experience 3 -->
          <div class="accordion-item">
            <button class="accordion-header" data-accordion="exp-3">
              <div class="flex-1 text-left">
                <h3 class="font-display text-xl md:text-2xl font-semibold mb-1">
                  Spécialiste Technique <span class="text-accent block md:inline">@ APPLE</span>
                </h3>
                <p class="text-xs font-mono text-tertiary uppercase">Juin 2016 – Déc 2019</p>
              </div>
              <svg class="chevron w-6 h-6 text-tertiary transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="accordion-content" id="exp-3">
              <div>
                <ul class="space-y-3 text-sm text-secondary p-6">
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Diagnostic et réparation de problèmes matériels/logiciels complexes à grande échelle ; formation de nouveaux techniciens.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="text-accent font-bold shrink-0">→</span>
                    <span>Plus de 500 diagnostics avancés et réparations par an ; maintien d'une qualité de service élevée.</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Education Section (Accordion) -->
  <section id="education" class="section-spacing bg-surface/30 opacity-0 animate-fade-in-up delay-800">
    <div class="content-width">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-display text-3xl md:text-4xl font-semibold mb-10">
          <span class="text-accent italic">Formation</span>
        </h2>

        <div class="accordion-item">
          <button class="accordion-header" data-accordion="edu-1">
            <div class="flex-1 text-left">
              <h3 class="font-display text-xl md:text-2xl font-semibold mb-1">
                Développeur Web & Mobile <span class="text-accent block md:inline">@ O'Clock</span>
              </h3>
              <p class="text-xs font-mono text-tertiary uppercase">Mai 2022 – Oct 2022</p>
            </div>
            <svg class="chevron w-6 h-6 text-tertiary transition-transform duration-200 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="accordion-content" id="edu-1">
            <div>
              <ul class="space-y-3 text-sm text-secondary p-6">
                <li class="flex gap-3">
                  <span class="text-accent font-bold shrink-0">→</span>
                  <span>Bootcamp de plus de 700 heures couvrant HTML, CSS, JavaScript, React, accessibilité, SEO, Agile, TDD.</span>
                </li>
                <li class="flex gap-3">
                  <span class="text-accent font-bold shrink-0">→</span>
                  <span>Réalisation d'un projet final full-stack de la conception au déploiement.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section-spacing opacity-0 animate-fade-in-up delay-900">
    <div class="content-width">
      <div class="card-hover text-center max-w-3xl mx-auto grain-texture relative overflow-hidden">
        <!-- Decorative blob -->
        <div class="blob-bg -bottom-20 -right-20 w-80 h-80 bg-success"></div>

        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold mb-6 relative z-10">
          Créons <span class="text-accent italic">Ensemble</span>
        </h2>

        <p class="text-lg text-secondary mb-10 max-w-2xl mx-auto relative z-10">
          Besoin d'aide pour créer un produit IA, automatiser un workflow ou développer une application web scalable ? Je suis disponible pour des projets freelance.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center relative z-10">
          <a href="/fr/contact" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Envoyer un message
          </a>

          <a href="https://linkedin.com/in/joris-neblai" target="_blank" rel="noreferrer" class="btn-secondary">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="content-width">
    <Footer />
  </div>
</BaseLayout>

<style>
  /* About section mobile accordion */
  .about-expanded {
    display: none;
  }

  @media (min-width: 768px) {
    .about-expanded {
      display: block !important;
    }
    #read-more-btn {
      display: none !important;
    }
  }

  /* Accordion styles */
  .accordion-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .accordion-header:hover {
    border-color: var(--accent-primary);
    background: var(--bg-elevated);
  }

  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .accordion-content > div {
    overflow: hidden;
  }

  .accordion-content.open {
    grid-template-rows: 1fr;
  }

  .accordion-header[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  // About section Read More toggle (mobile only)
  document.addEventListener('DOMContentLoaded', () => {
    const readMoreBtn = document.getElementById('read-more-btn');
    const aboutExpanded = document.getElementById('about-expanded');
    const readMoreText = document.getElementById('read-more-text');
    const chevronIcon = document.getElementById('chevron-icon');

    if (readMoreBtn && aboutExpanded && readMoreText && chevronIcon) {
      readMoreBtn.addEventListener('click', () => {
        const isExpanded = readMoreBtn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          aboutExpanded.style.display = 'none';
          readMoreBtn.setAttribute('aria-expanded', 'false');
          readMoreText.textContent = 'Lire plus';
          chevronIcon.style.transform = 'rotate(0deg)';
        } else {
          aboutExpanded.style.display = 'block';
          readMoreBtn.setAttribute('aria-expanded', 'true');
          readMoreText.textContent = 'Lire moins';
          chevronIcon.style.transform = 'rotate(180deg)';
        }
      });
    }

    // Accordion functionality
    const accordionHeaders = document.querySelectorAll('.accordion-header');

    accordionHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const accordionId = header.getAttribute('data-accordion');
        if (!accordionId) return;

        const content = document.getElementById(accordionId);
        const isExpanded = header.getAttribute('aria-expanded') === 'true';

        if (content) {
          if (isExpanded) {
            content.classList.remove('open');
            header.setAttribute('aria-expanded', 'false');
          } else {
            content.classList.add('open');
            header.setAttribute('aria-expanded', 'true');
          }
        }
      });
    });
  });
</script>
