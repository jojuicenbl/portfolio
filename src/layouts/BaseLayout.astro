---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Joris Neblai — Portfolio", description = "Full-Stack Web Developer" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icons/favicon.svg" />
  </head>
  <body class="bg-white text-neutral-900 antialiased selection:bg-neutral-900 selection:text-white">
    <main class="container max-w-3xl px-4 py-10">
      <slot />
    </main>
  </body>
</html>
