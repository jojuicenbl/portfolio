---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---
<section id={id} class="mb-16 md:mb-20 scroll-mt-20 opacity-0 animate-fade-in-up">
  <div class="relative mb-6 md:mb-8">
    <div class="inline-block relative">
      <h2 class="font-display font-bold text-2xl md:text-3xl lg:text-4xl capitalize tracking-tight relative z-10">{title}</h2>
      <div class="absolute -bottom-1 left-0 w-16 md:w-20 h-1 bg-[var(--color-accent)] rounded-full"></div>
    </div>
  </div>
  <div class="space-y-6 pl-0 md:pl-6 border-l-0 md:border-l-2 md:border-[var(--color-accent)]">
    <slot />
  </div>
</section>
