---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---
<section id={id} class="mb-16 scroll-mt-20">
  <div class="flex items-center gap-4 mb-6">
    <h2 class="text-2xl font-bold tracking-tight bg-gradient-to-r from-indigo-400 to-purple-500 bg-clip-text text-transparent">{title}</h2>
    <div class="flex-1 h-px bg-gradient-to-r from-neutral-300 dark:from-neutral-800 to-transparent"></div>
  </div>
  <div class="space-y-4">
    <slot />
  </div>
</section>
