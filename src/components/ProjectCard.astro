---
interface Props {
  title: string;
  description: string;
  url?: string;
}

const { title, description, url } = Astro.props;
---
<article class="group relative rounded-lg border-2 border-[var(--color-border-light)] p-5 md:p-6 hover:border-[var(--color-accent)] hover:shadow-lg transition-all duration-200 bg-[var(--color-bg-secondary)]">
  <div class="absolute top-0 left-0 w-1 h-12 bg-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-opacity duration-200 rounded-tl-lg"></div>

  <h3 class="font-display font-bold text-lg md:text-xl mb-3 capitalize tracking-tight group-hover:text-[var(--color-accent)] transition-colors duration-200">{title}</h3>
  <p class="text-sm leading-relaxed text-[var(--color-text-secondary)] font-mono">{description}</p>

  {url && (
    <a
      href={url}
      class="mt-4 inline-flex items-center gap-2 text-sm font-mono font-semibold capitalize text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors duration-150 group/link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="text-[var(--color-accent)]">&gt;</span>
      <span>View project</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover/link:translate-x-1 transition-transform duration-150" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  )}

  <div class="absolute bottom-0 right-0 w-2 h-2 rounded-sm bg-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
</article>
