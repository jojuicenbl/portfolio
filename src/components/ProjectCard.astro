---
interface Props {
  title: string;
  description: string;
  url?: string;
  tags?: string[];
  image?: string;
}

const { title, description, url, tags = [], image } = Astro.props;
---
<article class="group card-hover overflow-hidden">
  {image ? (
    <div class="aspect-video overflow-hidden rounded-t-lg -m-8 mb-6">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy" decoding="async"
      />
    </div>
  ) : (
    <div class="aspect-video overflow-hidden rounded-t-lg -m-8 mb-6 bg-gradient-to-br from-accent-light via-surface to-accent-light flex items-center justify-center">
      <div class="text-center text-tertiary">
        <svg class="w-16 h-16 mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        <p class="text-xs font-mono">Preview coming soon</p>
      </div>
    </div>
  )}

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map(tag => (
        <span class="text-xs font-mono px-3 py-1 bg-accent-light text-accent rounded-sm">
          {tag}
        </span>
      ))}
    </div>
  )}

  <h3 class="font-display text-2xl font-semibold mb-3 group-hover:text-accent transition-colors">
    {title}
  </h3>

  <p class="text-sm text-secondary leading-relaxed mb-6 line-clamp-2">
    {description}
  </p>

  {url && (
    <a
      href={url}
      class="inline-flex items-center gap-2 text-sm font-mono font-medium text-accent hover:underline group/link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>View project</span>
      <svg class="w-4 h-4 group-hover/link:translate-x-1 transition-transform duration-150" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  )}
</article>
