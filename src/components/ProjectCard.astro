---
interface Props {
  title: string;
  description: string;
  url?: string;
}

const { title, description, url } = Astro.props;
---
<article class="border rounded-xl p-4">
  <h3 class="font-medium">{title}</h3>
  <p class="mt-2 text-sm opacity-80">{description}</p>
  {url && <a href={url} class="mt-3 inline-block underline">View</a>}
</article>
