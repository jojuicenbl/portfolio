---
const links = [
  { href: "/#about", label: "About" },
  { href: "/#experiences", label: "Experiences" },
  { href: "/contact", label: "Contact" },
  { href: "/projects", label: "Projects", isHighlight: true }
];
---
<header class="mb-12 border-b border-neutral-300 dark:border-neutral-800 pb-6 transition-colors">
  <div class="flex items-center justify-between">
    <!-- Logo and Profile -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/self-pic-cropped.jpg"
        alt="Joris Neblai"
        class="w-12 h-12 rounded-full ring-2 ring-neutral-300 dark:ring-neutral-800 group-hover:ring-indigo-500 transition-all"
      />
      <span class="font-semibold text-lg">Joris Neblai</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-2">
      <nav class="flex gap-1 text-sm">
        {links.map(l => (
          l.isHighlight ? (
            <a
              href={l.href}
              class="px-4 py-2 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-medium hover:from-indigo-600 hover:to-purple-700 transition-all shadow-lg shadow-indigo-500/20"
            >
              {l.label}
            </a>
          ) : (
            <a
              href={l.href}
              class="px-4 py-2 rounded-lg opacity-70 hover:opacity-100 hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
            >
              {l.label}
            </a>
          )
        ))}
      </nav>

      <!-- Theme Toggle Desktop -->
      <button
        id="theme-toggle-desktop"
        class="ml-2 p-2 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
        aria-label="Toggle theme"
      >
        <svg id="sun-icon-desktop" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="moon-icon-desktop" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex md:hidden items-center gap-2">
      <!-- Theme Toggle Mobile -->
      <button
        id="theme-toggle-mobile"
        class="p-2 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
        aria-label="Toggle theme"
      >
        <svg id="sun-icon-mobile" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="moon-icon-mobile" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Burger Menu Button -->
      <button
        id="mobile-menu-button"
        class="p-2 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <nav id="mobile-menu" class="hidden md:hidden mt-4 pt-4 border-t border-neutral-300 dark:border-neutral-800 flex-col gap-2">
    {links.map(l => (
      l.isHighlight ? (
        <a
          href={l.href}
          class="px-4 py-3 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-medium text-center block"
        >
          {l.label}
        </a>
      ) : (
        <a
          href={l.href}
          class="px-4 py-3 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all text-center block"
        >
          {l.label}
        </a>
      )
    ))}
  </nav>
</header>

<script>
  // Theme toggle functionality
  function updateThemeIcons(isDark: boolean) {
    // Desktop icons
    const sunIconDesktop = document.getElementById('sun-icon-desktop');
    const moonIconDesktop = document.getElementById('moon-icon-desktop');

    // Mobile icons
    const sunIconMobile = document.getElementById('sun-icon-mobile');
    const moonIconMobile = document.getElementById('moon-icon-mobile');

    if (isDark) {
      // Dark mode: show sun icon (to switch to light)
      sunIconDesktop?.classList.remove('hidden');
      sunIconDesktop?.classList.add('block');
      moonIconDesktop?.classList.add('hidden');
      moonIconDesktop?.classList.remove('block');

      sunIconMobile?.classList.remove('hidden');
      sunIconMobile?.classList.add('block');
      moonIconMobile?.classList.add('hidden');
      moonIconMobile?.classList.remove('block');
    } else {
      // Light mode: show moon icon (to switch to dark)
      sunIconDesktop?.classList.add('hidden');
      sunIconDesktop?.classList.remove('block');
      moonIconDesktop?.classList.remove('hidden');
      moonIconDesktop?.classList.add('block');

      sunIconMobile?.classList.add('hidden');
      sunIconMobile?.classList.remove('block');
      moonIconMobile?.classList.remove('hidden');
      moonIconMobile?.classList.add('block');
    }
  }

  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.contains('dark');

    if (isDark) {
      html.classList.remove('dark');
      localStorage.setItem('theme', 'light');
      updateThemeIcons(false);
    } else {
      html.classList.add('dark');
      localStorage.setItem('theme', 'dark');
      updateThemeIcons(true);
    }
  }

  // Initialize icons on page load
  document.addEventListener('DOMContentLoaded', () => {
    const isDark = document.documentElement.classList.contains('dark');
    updateThemeIcons(isDark);
  });

  // Mobile menu functionality
  function toggleMobileMenu() {
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileMenu && menuIcon && closeIcon) {
      const isHidden = mobileMenu.classList.contains('hidden');

      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('flex');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    }
  }

  // Attach event listeners
  document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
  document.getElementById('mobile-menu-button')?.addEventListener('click', toggleMobileMenu);

  // Close mobile menu when clicking on a link
  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      if (mobileMenu && menuIcon && closeIcon) {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });
  });
</script>
