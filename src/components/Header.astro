---
const links = [
  { href: "/#about", label: "About" },
  { href: "/#experiences", label: "Experiences" },
  { href: "/contact", label: "Contact" },
  { href: "/projects", label: "Projects", isHighlight: true }
];
---
<header
  class="mb-12 border-b border-neutral-300 dark:border-neutral-800 pb-6 transition-colors"
  x-data="{ mobileMenuOpen: false, darkMode: localStorage.getItem('theme') === 'light' ? false : true }"
  x-init="$watch('darkMode', value => {
    localStorage.setItem('theme', value ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', value);
  })"
>
  <div class="flex items-center justify-between">
    <!-- Logo and Profile -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/self-pic-cropped.jpg"
        alt="Joris Neblai"
        class="w-12 h-12 rounded-full ring-2 ring-neutral-300 dark:ring-neutral-800 group-hover:ring-indigo-500 transition-all"
      />
      <span class="font-semibold text-lg">Joris Neblai</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-2">
      <nav class="flex gap-1 text-sm">
        {links.map(l => (
          l.isHighlight ? (
            <a
              href={l.href}
              class="px-4 py-2 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-medium hover:from-indigo-600 hover:to-purple-700 transition-all shadow-lg shadow-indigo-500/20"
            >
              {l.label}
            </a>
          ) : (
            <a
              href={l.href}
              class="px-4 py-2 rounded-lg opacity-70 hover:opacity-100 hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
            >
              {l.label}
            </a>
          )
        ))}
      </nav>

      <!-- Theme Toggle -->
      <button
        @click="darkMode = !darkMode"
        class="ml-2 p-2 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
        aria-label="Toggle theme"
      >
        <svg x-show="darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex md:hidden items-center gap-2">
      <!-- Theme Toggle Mobile -->
      <button
        @click="darkMode = !darkMode"
        class="p-2 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
        aria-label="Toggle theme"
      >
        <svg x-show="darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <button
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="p-2 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all"
        aria-label="Toggle menu"
      >
        <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <nav
    x-show="mobileMenuOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 transform scale-95"
    x-transition:enter-end="opacity-100 transform scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 transform scale-100"
    x-transition:leave-end="opacity-0 transform scale-95"
    class="md:hidden mt-4 pt-4 border-t border-neutral-300 dark:border-neutral-800 flex flex-col gap-2"
  >
    {links.map(l => (
      l.isHighlight ? (
        <a
          href={l.href}
          class="px-4 py-3 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-medium text-center"
        >
          {l.label}
        </a>
      ) : (
        <a
          href={l.href}
          class="px-4 py-3 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800/50 transition-all text-center"
        >
          {l.label}
        </a>
      )
    ))}
  </nav>
</header>
