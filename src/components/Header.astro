---
import { Image } from 'astro:assets';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: 'en' | 'fr';
}

const { locale = 'en' } = Astro.props;

// Build localized links based on current locale
const localePrefix = locale === 'fr' ? '/fr' : '';
const links = [
  { href: `${localePrefix}/#work`, label: locale === 'fr' ? 'projets' : 'work' },
  { href: `${localePrefix}/#services`, label: 'services' },
  { href: `${localePrefix}/#about`, label: locale === 'fr' ? 'à propos' : 'about' },
  { href: `${localePrefix}/contact`, label: 'contact' }
];
---
<header class="relative md:sticky top-0 left-0 right-0 z-50 mb-12 md:mb-16 opacity-0 animate-fade-in-up transition-all duration-300 border-b border-border-subtle bg-paper/80 backdrop-blur-md">
  <div class="content-width py-6 md:py-8">
    <div class="flex items-center justify-between">
      <!-- Logo and Profile -->
      <a href={locale === 'fr' ? '/fr' : '/'} class="flex items-center gap-3 group relative">
        <div class="relative">
          <Image
            src="/self-pic-grad.png"
            alt="Joris Neblai"
            width={48}
            height={48}
            class="rounded-lg border border-border-subtle group-hover:border-accent transition-all duration-200"
            loading="eager"
            format="webp"
            quality={95}
            densities={[1, 2]}
          />
          <div class="absolute -bottom-1 -right-1 w-2.5 h-2.5 rounded-full bg-accent"></div>
        </div>
        <div>
          <span class="font-display font-semibold text-lg md:text-xl block">Joris Neblai</span>
          <span class="text-xs text-secondary font-mono">&gt; freelance dev</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-6">
        <nav class="flex gap-1 text-sm font-body">
          {links.map(l => (
            <a
              href={l.href}
              class="px-4 py-2 rounded-md text-secondary hover:text-primary hover:bg-surface transition-all duration-200 capitalize"
            >
              {l.label}
            </a>
          ))}
        </nav>

        <!-- Utilities: Language + Theme -->
        <div class="flex items-center gap-2 ml-2 pl-6 border-l border-border-subtle">
          <!-- Language Switcher Desktop -->
          <LanguageSwitcher currentLocale={locale} />

          <!-- Theme Toggle Desktop -->
          <button
            id="theme-toggle-desktop"
            class="p-2 rounded-md text-secondary hover:text-primary hover:bg-surface transition-all duration-200"
            aria-label="Toggle theme"
          >
            <svg id="sun-icon-desktop" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="moon-icon-desktop" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Controls -->
      <div class="flex md:hidden items-center gap-2">
        <!-- Theme Toggle Mobile -->
        <button
          id="theme-toggle-mobile"
          class="p-2 rounded-md text-secondary hover:text-primary hover:bg-surface transition-all duration-200"
          aria-label="Toggle theme"
        >
          <svg id="sun-icon-mobile" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="moon-icon-mobile" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Burger Menu Button -->
        <button
          id="mobile-menu-button"
          class="p-2 rounded-md border border-border-subtle hover:border-border-medium transition-all duration-200"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <nav id="mobile-menu" class="hidden md:hidden mt-6 pt-6 border-t border-border-subtle flex-col gap-2">
      {links.map(l => (
        <a
          href={l.href}
          class="px-4 py-3 rounded-md border border-border-subtle hover:border-accent hover:bg-surface transition-all text-center block capitalize font-body text-sm"
        >
          {l.label}
        </a>
      ))}

      <!-- Language Switcher in Mobile Menu -->
      <div class="mt-2 pt-4 border-t border-border-subtle flex justify-center">
        <LanguageSwitcher currentLocale={locale} />
      </div>
    </nav>
  </div>
</header>

<script>
  function updateThemeIcons(isDark: boolean) {
    const sunIconDesktop = document.getElementById('sun-icon-desktop');
    const moonIconDesktop = document.getElementById('moon-icon-desktop');
    const sunIconMobile = document.getElementById('sun-icon-mobile');
    const moonIconMobile = document.getElementById('moon-icon-mobile');

    if (isDark) {
      sunIconDesktop?.classList.remove('hidden'); sunIconDesktop?.classList.add('block');
      moonIconDesktop?.classList.add('hidden');   moonIconDesktop?.classList.remove('block');
      sunIconMobile?.classList.remove('hidden');  sunIconMobile?.classList.add('block');
      moonIconMobile?.classList.add('hidden');    moonIconMobile?.classList.remove('block');
    } else {
      sunIconDesktop?.classList.add('hidden');    sunIconDesktop?.classList.remove('block');
      moonIconDesktop?.classList.remove('hidden');moonIconDesktop?.classList.add('block');
      sunIconMobile?.classList.add('hidden');     sunIconMobile?.classList.remove('block');
      moonIconMobile?.classList.remove('hidden'); moonIconMobile?.classList.add('block');
    }
  }

  function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.classList.contains('dark');

    // Add transitioning class
    html.classList.add('transitioning');

    if (isDark) {
      html.classList.remove('dark');
      localStorage.setItem('theme', 'light');
      updateThemeIcons(false);
    } else {
      html.classList.add('dark');
      localStorage.setItem('theme', 'dark');
      updateThemeIcons(true);
    }

    // Remove transitioning class after animation completes
    setTimeout(() => {
      html.classList.remove('transitioning');
    }, 300);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const isDark = document.documentElement.classList.contains('dark');
    updateThemeIcons(isDark);

    document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
    document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
    document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      if (!mobileMenu || !menuIcon || !closeIcon) return;
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden'); mobileMenu.classList.add('flex');
        menuIcon.classList.add('hidden'); closeIcon.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden'); mobileMenu.classList.remove('flex');
        menuIcon.classList.remove('hidden'); closeIcon.classList.add('hidden');
      }
    });

    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');
        if (!mobileMenu || !menuIcon || !closeIcon) return;
        mobileMenu.classList.add('hidden'); mobileMenu.classList.remove('flex');
        menuIcon.classList.remove('hidden'); closeIcon.classList.add('hidden');
      });
    });
  });
</script>
